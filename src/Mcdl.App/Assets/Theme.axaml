<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 全局：13px、#343D4A，与 PCL 一致 -->
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray4}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource ColorBrushBackgroundTransparentSidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ColorBrush8}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush2}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="32" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ColorBrush3}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#C9CDD2" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- 标题栏胶囊标签：高 27、圆角 13.5（PCL 的 MyRadioButton 同尺寸） -->
  <Style Selector="Button.pill">
    <Setter Property="Height" Value="27" />
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="13.5" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource ColorBrushSemiTransparent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.pill /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="13.5" />
    <Setter Property="Background" Value="{DynamicResource ColorBrushSemiTransparent}" />
  </Style>
  <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#55FFFFFF" />
  </Style>
  <Style Selector="Button.pill.active">
    <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.pill.active /template/ ContentPresenter">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
  </Style>

  <!-- 标题栏窗口按钮：28×28 圆 -->
  <Style Selector="Button.caption">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.caption /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#44FFFFFF" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
    <Setter Property="Background" Value="White" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="White" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ColorBrush8}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

</Styles>
