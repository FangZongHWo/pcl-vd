<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mcdl.App.App"
             RequestedThemeVariant="Light">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://PclVd/Assets/Theme.axaml" />
  </Application.Styles>

  <!-- 对齐 PCL 的调色板：一个主色 + 8 级浓度，正文色 #343D4A -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PclVd/Assets/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <Color x:Key="AccentColor">#0C7BC0</Color>

      <SolidColorBrush x:Key="ColorBrush1" Color="#343D4A" />
      <SolidColorBrush x:Key="ColorBrush2" Color="#0C7BC0" />
      <SolidColorBrush x:Key="ColorBrush3" Color="#2E93D0" />
      <SolidColorBrush x:Key="ColorBrush4" Color="#5AAADE" />
      <SolidColorBrush x:Key="ColorBrush5" Color="#86C1E8" />
      <SolidColorBrush x:Key="ColorBrush6" Color="#B3D8F2" />
      <SolidColorBrush x:Key="ColorBrush7" Color="#D6EAF9" />
      <SolidColorBrush x:Key="ColorBrush8" Color="#EDF6FC" />

      <SolidColorBrush x:Key="ColorBrushSemiTransparent" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="ColorBrushBackgroundTransparentSidebar" Color="#F1FFFFFF" />
      <SolidColorBrush x:Key="ColorBrushGray4" Color="#8A8A8A" />

      <SolidColorBrush x:Key="AccentBrush" Color="#0C7BC0" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#D6EAF9" />
      <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />

      <SolidColorBrush x:Key="PageBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BorderBrush2" Color="#D9D9D9" />
      <SolidColorBrush x:Key="BorderSoftBrush" Color="#EBEBEB" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#343D4A" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8A8A8A" />
      <SolidColorBrush x:Key="RailBrush" Color="#F1FFFFFF" />
    </ResourceDictionary>
  </Application.Resources>

</Application>
