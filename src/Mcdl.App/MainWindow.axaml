<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Mcdl.App.MainWindow"
        Title="PCL VD"
        Width="1000" Height="660"
        MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Icon="/Assets/app.ico"
        Background="Transparent"
        FontFamily="avares://PclVd/Assets/pcl-font.ttf#PCL English, Microsoft YaHei UI">

  <!-- PCL 的窗口形态：透明窗口 + 圆角浮层 + 阴影 -->
  <Border Margin="8" CornerRadius="6" Background="White" ClipToBounds="True"
          BoxShadow="0 3 14 0 #33000000">
    <Grid RowDefinitions="48,*,22">

      <!-- 标题栏：主色底 + 左侧 Logo + 中间胶囊标签 + 右侧圆钮 -->
      <Grid Grid.Row="0" Background="{DynamicResource ColorBrush2}" PointerPressed="OnTitleBarPressed">
        <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center" Spacing="9">
          <Image Source="/Assets/app-256.png" Width="20" Height="20" />
          <TextBlock Text="PCL VD" Foreground="White" FontSize="15" FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
          <Button Classes="pill" Classes.active="{Binding IsVersionTab}"
                  Command="{Binding ShowVersionsCommand}" ToolTip.Tip="下载游戏版本与加载器">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource IconDownload}" Width="13" Height="13" Stretch="Uniform"
                    Fill="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="下载" Foreground="{Binding $parent[Button].Foreground}" FontSize="13" />
            </StackPanel>
          </Button>
          <Button Classes="pill" Classes.active="{Binding IsResourceTab}"
                  Command="{Binding ShowResourcesCommand}" ToolTip.Tip="模组 / 光影 / 资源包 / 整合包">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource IconResource}" Width="13" Height="13" Stretch="Uniform"
                    Fill="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="资源" Foreground="{Binding $parent[Button].Foreground}" FontSize="13" />
            </StackPanel>
          </Button>
          <Button Classes="pill" Classes.active="{Binding IsAboutTab}"
                  Command="{Binding ShowAboutCommand}" ToolTip.Tip="关于 PCL VD 与许可">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource IconInfo}" Width="13" Height="13" Stretch="Uniform"
                    Fill="{Binding $parent[Button].Foreground}" />
              <TextBlock Text="关于" Foreground="{Binding $parent[Button].Foreground}" FontSize="13" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,12,0" Spacing="4">
          <Button Classes="caption" Content="—" Click="OnMinimizeClick" ToolTip.Tip="最小化" />
          <Button Classes="caption" Click="OnCloseClick" ToolTip.Tip="关闭">
            <Path Data="{StaticResource IconClose}" Width="11" Height="11" Stretch="Uniform"
                  Fill="{Binding $parent[Button].Foreground}" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- 目标目录 -->
      <Border Grid.Row="1" VerticalAlignment="Top" Background="#FAFAFA"
              BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="12,6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Text=".minecraft" Classes="muted" VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <TextBox Grid.Column="1" x:Name="PathBox" Text="{Binding TargetDir, Mode=TwoWay}"
                   Watermark="选择 .minecraft 文件夹" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="浏览…" Margin="8,0,0,0" Click="OnBrowseClick"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- 页面区 -->
      <Grid Grid.Row="1" Margin="0,41,0,0">

        <!-- 页面一：下载 -->
        <Grid x:Name="PageVersion" ColumnDefinitions="270,*" IsVisible="{Binding IsVersionTab}">

          <Border Grid.Column="0" Classes="sidebar" Padding="10,8">
            <Grid RowDefinitions="Auto,Auto,*">
              <TextBox Grid.Row="0" Text="{Binding SearchText, Mode=TwoWay}" Watermark="搜索版本，如 26.3 / 1.20" />
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="2,8,2,4">
                <TextBlock Grid.Column="0" Classes="muted" Text="{Binding VersionCountText}" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowSnapshots, Mode=TwoWay}" OnContent="含快照"
                              OffContent="仅正式" FontSize="11" />
              </Grid>
              <ListBox Grid.Row="2" ItemsSource="{Binding Versions}"
                       SelectedItem="{Binding SelectedVersion, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0" Height="30" VerticalAlignment="Center">
                      <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="13" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding SubText}" FontSize="11" Margin="8,0,0,0"
                                 VerticalAlignment="Center" Foreground="{DynamicResource ColorBrushGray4}" />
                      <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" FontSize="11" VerticalAlignment="Center"
                                 Foreground="{DynamicResource ColorBrush2}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="18,10,18,10">
            <StackPanel Grid.Row="0" Spacing="3">
              <TextBlock Classes="h1" Text="{Binding DetailTitle}" />
              <TextBlock Classes="muted" Text="{Binding DetailSubtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
              <StackPanel Spacing="10" Width="520" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h2" Text="数据源" />
                  <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}" />
                  <TextBlock Text="{Binding SourceHint}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Classes="h2" Text="模组加载器" />
                  <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding SelectedLoader, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Classes="h2" Text="加载器版本" />
                  <ComboBox ItemsSource="{Binding LoaderVersions}"
                            SelectedItem="{Binding SelectedLoaderVersion, Mode=TwoWay}"
                            IsEnabled="{Binding IsLoaderVersionEnabled}" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Classes="h2" Text="Java 运行时" />
                  <ComboBox ItemsSource="{Binding JavaOptions}" SelectedItem="{Binding SelectedJava, Mode=TwoWay}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0" Width="520" HorizontalAlignment="Left">
              <Border CornerRadius="3" Background="{DynamicResource ColorBrush8}" Padding="10,8"
                      IsVisible="{Binding IsBusy}">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="11"
                               Foreground="{DynamicResource ColorBrushGray4}" Margin="8,0,0,0" />
                  </Grid>
                  <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressValue}" />
                  <TextBlock Text="{Binding CurrentFileName}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <Button Classes="primary" Content="{Binding InstallButtonText}"
                      Command="{Binding InstallCommand}" HorizontalAlignment="Stretch" />
              <TextBlock Text="{Binding StatusText}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- 页面二：资源 -->
        <Grid x:Name="PageResource" ColumnDefinitions="290,*" IsVisible="{Binding IsResourceTab}">
          <Border Grid.Column="0" Classes="sidebar" Padding="10,8">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
              <TextBox Grid.Row="0" x:Name="ResourceSearchBox" Text="{Binding ResourceQuery, Mode=TwoWay}"
                       Watermark="搜索模组 / 光影 / 资源包 / 整合包" KeyDown="OnResourceSearchKeyDown" />
              <Grid Grid.Row="1" ColumnDefinitions="*,8,Auto" Margin="0,6,0,6">
                <ComboBox Grid.Column="0" ItemsSource="{Binding ResourceTypeOptions}"
                          SelectedItem="{Binding SelectedResourceType, Mode=TwoWay}" />
                <Button Grid.Column="2" Content="搜索" Command="{Binding SearchResourcesCommand}" />
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="1.3*,8,*" Margin="0,0,0,6">
                <ComboBox Grid.Column="0" ItemsSource="{Binding ResourceVersionOptions}"
                          SelectedItem="{Binding SelectedResourceVersionOption, Mode=TwoWay}"
                          ToolTip.Tip="按游戏版本筛选；默认跟随当前实例" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding ResourceLoaderOptions}"
                          SelectedItem="{Binding SelectedResourceLoaderOption, Mode=TwoWay}"
                          ToolTip.Tip="按加载器筛选；光影和资源包不受影响" />
              </Grid>
              <TextBlock Grid.Row="3" Classes="muted" Text="{Binding ResourceCountText}" Margin="2,0,2,6" />
              <ListBox Grid.Row="4" ItemsSource="{Binding ResourceResults}"
                       SelectedItem="{Binding SelectedResource, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*" Margin="6,4">
                      <Border Width="32" Height="32" CornerRadius="3" ClipToBounds="True" VerticalAlignment="Top"
                              Background="{DynamicResource ColorBrush8}">
                        <Panel>
                          <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{DynamicResource ColorBrush2}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Image Source="{Binding Icon}" Stretch="UniformToFill" IsVisible="{Binding HasIcon}" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="1">
                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" FontSize="11" MaxLines="2" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrushGray4}" />
                        <TextBlock Text="{Binding StatsText}" FontSize="11"
                                   Foreground="{DynamicResource ColorBrushGray4}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="18,10,18,10">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
              <Border Width="52" Height="52" CornerRadius="3" ClipToBounds="True" VerticalAlignment="Top"
                      Background="{DynamicResource ColorBrush8}">
                <Panel>
                  <TextBlock Text="?" FontSize="18" FontWeight="SemiBold"
                             Foreground="{DynamicResource ColorBrush2}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Source="{Binding ResourceIcon}" Stretch="UniformToFill"
                         IsVisible="{Binding HasResourceIcon}" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3" VerticalAlignment="Center">
                <TextBlock Classes="h1" Text="{Binding ResourceTitle}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ResourceSubtitle}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource ColorBrushGray4}" />
              </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
              <StackPanel Spacing="10" Width="560" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h2" Text="安装到" />
                  <TextBlock Text="{Binding ResourceTargetText}" FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource ColorBrushGray4}" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Classes="h2" Text="选择版本" />
                  <ComboBox ItemsSource="{Binding ResourceVersions}"
                            SelectedItem="{Binding SelectedResourceVersion, Mode=TwoWay}"
                            IsEnabled="{Binding HasResourceVersions}" />
                </StackPanel>
                <Border CornerRadius="3" Background="{DynamicResource ColorBrush8}" Padding="10,8"
                        IsVisible="{Binding IsResourceBusy}">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding ResourceProgressText}" FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding ResourceSpeedText}" FontSize="11"
                                 Foreground="{DynamicResource ColorBrushGray4}" Margin="8,0,0,0" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ResourceProgressValue}" />
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding ResourceHint}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource ColorBrushGray4}" />
              </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0" Width="560" HorizontalAlignment="Left">
              <Button Classes="primary" Content="{Binding InstallResourceButtonText}"
                      Command="{Binding InstallResourceCommand}" HorizontalAlignment="Stretch" />
              <TextBlock Text="{Binding ResourceStatus}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- 页面三：关于 -->
        <Border x:Name="PageAbout" IsVisible="{Binding IsAboutTab}" Padding="18">
          <ScrollViewer>
            <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Image Source="/Assets/app-256.png" Width="48" Height="48" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="PCL VD" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Text="Minecraft 版本 / 模组 下载器 · 社区版本" Classes="muted" />
                </StackPanel>
              </StackPanel>

              <Border Height="1" Background="{DynamicResource BorderSoftBrush}" />

              <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21"
                         Text="PCL VD 是第三方基于 Plain Craft Launcher（PCL）独立进行的二次创作，与 PCL 官方无关，也不是 PCL 的官方后续版本。" />

              <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21"
                         Foreground="{DynamicResource ColorBrushGray4}"
                         Text="本项目沿用了 PCL 的部分下载与检索设计、以及 PCL 的 MC 百科中英对照表（WikiEntries），依《PCL 存储库合理使用指南》「重度使用」条款使用：已标注第三方身份、名称以 PCL 开头并带第三方后缀、界面主色相为蓝色、并在本页首位给出作者署名与赞助入口。" />

              <TextBlock TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Text="原作者：龙腾猫跃（LTCat）" />

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="PCL 项目主页" Click="OnOpenPclRepoClick" />
                <Button Content="赞助作者（爱发电）" Click="OnOpenSponsorClick" />
                <Button Content="查看许可指南" Click="OnOpenLicenceClick" />
              </StackPanel>

              <Border Height="1" Background="{DynamicResource BorderSoftBrush}" />

              <StackPanel Spacing="3">
                <TextBlock Classes="h2" Text="数据来源" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ColorBrushGray4}"
                           Text="版本与依赖：Mojang piston-meta / piston-data（可换 BMCLAPI 镜像）；模组与整合包：Modrinth API v2；中文名对照：PCL WikiEntries（源自 MC 百科）。" />
              </StackPanel>

              <StackPanel Spacing="3">
                <TextBlock Classes="h2" Text="版权与许可" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ColorBrushGray4}"
                           Text="PCL 及其相关资源版权归龙腾猫跃所有；本程序仅为第三方二次创作，公开源代码并沿用同一份许可指南（随程序附带 LICENCE-PCL.txt）。" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- 日志浮层 -->
        <Border VerticalAlignment="Bottom" Height="170" IsVisible="{Binding IsLogVisible}"
                Background="White" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                CornerRadius="3" Margin="12">
          <ScrollViewer Margin="10">
            <TextBlock Text="{Binding LogText}" FontFamily="Consolas,monospace" FontSize="11"
                       TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray4}" />
          </ScrollViewer>
        </Border>

      </Grid>

      <!-- 状态栏 -->
      <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="{DynamicResource BorderSoftBrush}"
              BorderThickness="0,1,0,0" Padding="12,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding FooterText}" FontSize="11"
                     Foreground="{DynamicResource ColorBrushGray4}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="link" Content="日志" Command="{Binding ToggleLogCommand}" />
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>
