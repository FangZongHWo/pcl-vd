<Application x:Class="Mcdl.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Mcdl.App">
  <Application.Resources>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- PCL 调色板：一个主色 + 8 级浓度 -->
    <Color x:Key="AccentColor">#0C7BC0</Color>
    <SolidColorBrush x:Key="ColorBrush1" Color="#343D4A" />
    <SolidColorBrush x:Key="ColorBrush2" Color="#0C7BC0" />
    <SolidColorBrush x:Key="ColorBrush3" Color="#2E93D0" />
    <SolidColorBrush x:Key="ColorBrush4" Color="#5AAADE" />
    <SolidColorBrush x:Key="ColorBrush5" Color="#86C1E8" />
    <SolidColorBrush x:Key="ColorBrush6" Color="#B3D8F2" />
    <SolidColorBrush x:Key="ColorBrush7" Color="#D6EAF9" />
    <SolidColorBrush x:Key="ColorBrush8" Color="#EDF6FC" />
    <SolidColorBrush x:Key="ColorBrushSemiTransparent" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ColorBrushGray4" Color="#8A8A8A" />
    <SolidColorBrush x:Key="ColorBrushSidebar" Color="#F1FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush2" Color="#D9D9D9" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#EBEBEB" />

    <!-- 文字 -->
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource ColorBrush1}" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource ColorBrush1}" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource ColorBrushGray4}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource ColorBrush1}" />
    </Style>

    <!-- 普通按钮 -->
    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource ColorBrush1}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColorBrush8}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 主按钮 -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Height" Value="32" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{StaticResource ColorBrush2}" />
      <Setter Property="BorderBrush" Value="{StaticResource ColorBrush2}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="3" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColorBrush3}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#C9CDD2" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="#C9CDD2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 标题栏胶囊标签：高 27、圆角 13.5 -->
    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="Height" Value="27" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource ColorBrushSemiTransparent}" CornerRadius="13.5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" />
              </Trigger>
              <Trigger Property="Tag" Value="active">
                <Setter TargetName="Bd" Property="Background" Value="White" />
                <Setter Property="Foreground" Value="{StaticResource ColorBrush2}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 标题栏窗口按钮：28×28 圆 -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="14">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 输入框 / 下拉 -->
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
      <Setter Property="Background" Value="White" />
    </Style>
    <!-- 下拉框：平边框 + 3px 圆角 + 白色弹层（PCL 风格） -->
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{StaticResource ColorBrush1}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="1" CornerRadius="3" SnapsToDevicePixels="True">
                      <Grid>
                        <ContentPresenter Margin="7,0,22,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                              Data="M0,0 L4.5,4.5 L9,0" Stroke="#6A6A6A" StrokeThickness="1.3" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ColorBrush5}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ColorBrush2}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                <Border Background="White" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                        CornerRadius="3" MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,2,0,6">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.4" Color="#000000" />
                  </Border.Effect>
                  <ScrollViewer>
                    <StackPanel IsItemsHost="True" Margin="2" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 复选框：自绘小方块，选中变主色 -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource ColorBrush1}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="14" Height="14" CornerRadius="3" Background="White"
                      BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" VerticalAlignment="Center">
                <Path x:Name="Tick" Data="M2,6 L5,9 L11,2" Stroke="White" StrokeThickness="1.6"
                      Visibility="Collapsed" />
              </Border>
              <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource ColorBrush2}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ColorBrush2}" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ColorBrush5}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 滚动条：6px 细条 -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" Width="6">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="#C4C9CE" CornerRadius="3" Width="6" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 列表 -->
    <Style TargetType="ListBox">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" SnapsToDevicePixels="True">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColorBrush8}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ColorBrush7}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Sidebar" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource ColorBrushSidebar}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

  </Application.Resources>
</Application>
