                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </Border>
        <!-- 关于页 -->
        <Border x:Name="PageAbout" Padding="18"
                Visibility="{Binding IsAboutTab, Converter={StaticResource BoolToVis}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Width="720" HorizontalAlignment="Center">

              <!-- 应用信息 -->
              <Border Background="White" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                      CornerRadius="3" Padding="18,16">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Image Grid.Column="0" Source="Assets/app.ico" Width="56" Height="56" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PCL VD" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Minecraft 版本 / 模组 下载器 · PCL 社区版本"
                               Style="{StaticResource Muted}" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="第三方二次创作" FontSize="11" Foreground="{StaticResource ColorBrush2}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="非官方版本" Style="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- 声明 -->
              <Border Background="White" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                      CornerRadius="3" Padding="18,16" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource H2}" Text="关于本项目" Margin="0,0,0,8" />
                  <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="22"
                             Text="PCL VD 是第三方基于 Plain Craft Launcher（PCL）独立进行的二次创作，与 PCL 官方无关，也不是 PCL 的官方后续版本。" />
                  <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="22" Margin="0,8,0,0"
                             Foreground="{StaticResource ColorBrushGray4}"
                             Text="本项目沿用了 PCL 的部分下载与检索设计、图标几何、字体与 MC 百科中英对照表（WikiEntries），依《PCL 存储库合理使用指南》「重度使用」条款使用：已标注第三方身份、名称以 PCL 开头并带第三方后缀、界面主色相为蓝色、公开源代码，并在下方给出作者署名与赞助入口。" />
                  <TextBlock Text="原作者：龙腾猫跃（LTCat）" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0" />
                </StackPanel>
              </Border>

              <!-- 相关链接 -->
              <Border Background="White" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                      CornerRadius="3" Padding="18,16" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource H2}" Text="相关链接" Margin="0,0,0,10" />
                  <WrapPanel>
                    <Button Style="{StaticResource FlatButton}" Content="源码仓库（GitHub）" Click="OnOpenRepoClick" Margin="0,0,8,8" />
                    <Button Style="{StaticResource FlatButton}" Content="PCL 项目主页" Click="OnOpenPclRepoClick" Margin="0,0,8,8" />
                    <Button Style="{StaticResource FlatButton}" Content="赞助作者（爱发电）" Click="OnOpenSponsorClick" Margin="0,0,8,8" />
                    <Button Style="{StaticResource FlatButton}" Content="许可指南" Click="OnOpenLicenceClick" Margin="0,0,8,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- 数据来源与许可 -->
              <Border Background="White" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                      CornerRadius="3" Padding="18,16" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource H2}" Text="数据来源" Margin="0,0,0,6" />
                  <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource ColorBrushGray4}"
                             Text="版本与依赖：Mojang piston-meta / piston-data（可在下载页切换 BMCLAPI 镜像）" />
                  <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource ColorBrushGray4}" Margin="0,2,0,0"
                             Text="模组与整合包：Modrinth API v2" />
                  <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource ColorBrushGray4}" Margin="0,2,0,0"
                             Text="中文名对照：PCL WikiEntries（源自 MC 百科）" />

                  <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,12" />

                  <TextBlock Style="{StaticResource H2}" Text="版权与许可" Margin="0,0,0,6" />
                  <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource ColorBrushGray4}"
                             Text="PCL 及其相关资源版权归龙腾猫跃所有；本程序代码以 CC BY-SA 4.0 发布，并跟随同一份许可指南（LICENCE-PCL.txt 随程序附带）。" />
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- 日志浮层 -->
        <Border VerticalAlignment="Bottom" Height="170" Margin="12"
                Background="White" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="3"
                Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVis}}">
          <ScrollViewer Margin="10">
            <TextBlock Text="{Binding LogText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource ColorBrushGray4}" />
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- 状态栏 -->
      <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0"
              Padding="12,0" CornerRadius="0,0,10,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding FooterText}" FontSize="11"
                     Foreground="{StaticResource ColorBrushGray4}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Command="{Binding ToggleLogCommand}"
                  Background="Transparent" BorderThickness="0" Foreground="{StaticResource ColorBrush2}"
                  FontSize="12" Cursor="Hand">
            <StackPanel Orientation="Horizontal">
              <Path Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                    Fill="{StaticResource ColorBrush2}"
                    Data="M384 128h640v128H384zM160 192m-96 0a96 96 0 1 0 192 0 96 96 0 1 0-192 0M384 448h640v128H384zM160 512m-96 0a96 96 0 1 0 192 0 96 96 0 1 0-192 0M384 768h640v128H384zM160 832m-96 0a96 96 0 1 0 192 0 96 96 0 1 0-192 0" />
              <TextBlock Text="日志" Margin="5,0,0,0" VerticalAlignment="Center"
                         Foreground="{StaticResource ColorBrush2}" FontSize="12" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
