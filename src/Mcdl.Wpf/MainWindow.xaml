                      </StackPanel>
                    </Button>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Java 路径" Style="{StaticResource Body}"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding JavaHome, Mode=TwoWay}"
                             VerticalAlignment="Center" />
